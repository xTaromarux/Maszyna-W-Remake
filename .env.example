NEXT_PUBLIC_APP_PLATFORM=web
# Public browser endpoint. Set an absolute URL when exporting a static site.
NEXT_PUBLIC_API_URL=/api/chat
NEXT_PUBLIC_HEALTH_URL=/health
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# Next server only: bundled hf-proxy listens on 8787.
API_PROXY_TARGET=http://127.0.0.1:8787
# Use 1 only for a legacy upstream serving /chat rather than /api/chat.
API_PROXY_STRIP_PREFIX=0
